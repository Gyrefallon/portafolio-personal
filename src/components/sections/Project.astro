---
import type { PortfolioContent } from '../../content/portfolio';
import Icon from '../ui/Icon.astro';

interface Props {
  t: PortfolioContent;
}

const { t } = Astro.props;
---

<section id="project" class="section scroll-mt-28 md:scroll-mt-20" aria-labelledby="project-title">
  <div class="container-page">
    <div class="reveal relative overflow-hidden rounded-4xl bg-ink px-6 py-12 text-white sm:px-10 lg:px-14 lg:py-16">
      <div class="bg-dot-grid-dark pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

      <div class="relative grid gap-10 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-white/70">
            <Icon name="lock" class="size-3.5 text-mint" />
            {t.projectLabel}
          </p>
          <h2 id="project-title" class="mt-6 text-h2">{t.projectTitle}</h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-white/70">{t.projectIntro}</p>
        </div>

        <div class="flex flex-col justify-between gap-6">
          <ul class="space-y-3">
            {t.projectHighlights.map((highlight, index) => (
              <li class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-4">
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-mint/10 font-mono text-[11px] text-mint" aria-hidden="true">0{index + 1}</span>
                <span class="text-sm text-white/80">{highlight}</span>
              </li>
            ))}
          </ul>
          <p class="flex items-start gap-3 rounded-2xl border border-white/10 p-4 text-xs leading-relaxed text-white/50">
            <Icon name="lock" class="mt-0.5 size-4 shrink-0" />
            <span>{t.projectDetails}</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
