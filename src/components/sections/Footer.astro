---
import type { PortfolioContent } from '../../content/portfolio';

interface Props {
  t: PortfolioContent;
}

const { t } = Astro.props;
---

<footer class="border-t border-line bg-canvas">
  <div class="container-page flex flex-col gap-2 py-8 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
    <p class="font-semibold text-ink">Gonzalo Peña Páez</p>
    <p>{t.footer} · Astro + Tailwind CSS</p>
  </div>
</footer>
