---
import type { PortfolioContent } from '../../content/portfolio';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  t: PortfolioContent;
}

const { t } = Astro.props;
const icons = ['server', 'plug', 'cloud'];
---

<section id="services" class="section scroll-mt-28 border-t border-line md:scroll-mt-20" aria-labelledby="services-title">
  <div class="container-page">
    <div class="reveal">
      <SectionHeading
        index="01"
        label={t.nav[0]}
        title={t.servicesTitle}
        intro={t.servicesIntro}
        titleId="services-title"
      />
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {t.services.map(([title, description], index) => (
        <article class="reveal group relative flex flex-col rounded-3xl border border-line bg-white p-7 transition duration-300 ease-expo hover:-translate-y-1 hover:border-ink/15 hover:shadow-card">
          <div class="flex items-center justify-between">
            <span class="grid size-12 place-items-center rounded-2xl bg-ink text-white transition duration-300 ease-expo group-hover:bg-accent">
              <Icon name={icons[index] ?? 'code'} class="size-5" />
            </span>
            <span class="font-mono text-[11px] text-muted/60" aria-hidden="true">0{index + 1}</span>
          </div>
          <h3 class="mt-8 text-lg font-semibold tracking-tight text-ink">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
