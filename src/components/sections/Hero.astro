---
import type { PortfolioContent } from '../../content/portfolio';
import Icon from '../ui/Icon.astro';

interface Props {
  t: PortfolioContent;
}

const { t } = Astro.props;

const profileCode = [
  '<span class="text-white/35">// perfil.ts</span>',
  '<span class="text-mint">const</span> perfil = {',
  '  rol: <span class="text-accent-soft">\'Backend developer\'</span>,',
  '  stack: [<span class="text-accent-soft">\'.NET\'</span>, <span class="text-accent-soft">\'Oracle\'</span>, <span class="text-accent-soft">\'Azure\'</span>],',
  '  foco: <span class="text-accent-soft">\'APIs + integraciones\'</span>,',
  '  exp: <span class="text-accent-soft">\'3+ años\'</span>,',
  '};'
].join('\n');
---

<section data-section="opening" aria-labelledby="title" class="relative overflow-hidden">
  <div class="hero-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-page grid items-center gap-14 py-14 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:py-24">
    <div class="reveal">
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-white/80 px-3.5 py-1.5 text-xs font-medium text-muted shadow-card">
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
        </span>
        {t.side}
      </p>

      <h1 id="title" class="mt-6 max-w-[15ch] text-display">{t.title}</h1>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-lg">{t.lead}</p>

      <div class="mt-8">
        <a href="#contact" class="btn btn-primary">
          {t.action}
          <Icon name="arrowRight" class="size-4" />
        </a>
      </div>

      <a
        href="#project"
        class="group mt-10 flex max-w-md items-start gap-4 rounded-2xl border border-line bg-white/80 p-4 transition duration-300 ease-expo hover:-translate-y-0.5 hover:border-ink/20 hover:bg-white hover:shadow-card"
      >
        <span class="hidden size-10 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent sm:grid">
          <Icon name="layers" class="size-5" />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block font-mono text-[10px] uppercase tracking-[0.14em] text-accent">{t.projectLabel}</span>
          <span class="mt-1 block text-sm font-semibold leading-snug text-ink">{t.projectTitle}</span>
          <span class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-ink">
            {t.viewProject}
            <Icon name="arrowRight" class="size-3.5 transition duration-300 ease-expo group-hover:translate-x-0.5" />
          </span>
        </span>
      </a>
    </div>

    <div class="reveal relative mx-auto w-full max-w-md lg:mr-0 lg:max-w-none">
      <div class="absolute -inset-8 -z-10 rounded-[3rem] bg-accent-soft/60 blur-3xl" aria-hidden="true"></div>

      <figure class="overflow-hidden rounded-4xl border border-ink/10 bg-ink shadow-float" aria-hidden="true">
        <div class="flex items-center gap-2 border-b border-white/10 px-5 py-3.5">
          <span class="size-2.5 rounded-full bg-white/15" aria-hidden="true"></span>
          <span class="size-2.5 rounded-full bg-white/15" aria-hidden="true"></span>
          <span class="size-2.5 rounded-full bg-white/15" aria-hidden="true"></span>
          <span class="ml-2 font-mono text-[11px] text-white/45">perfil.ts</span>
          <span class="ml-auto font-mono text-[10px] uppercase tracking-[0.18em] text-white/30">backend</span>
        </div>

        <pre class="overflow-x-auto px-5 py-6 font-mono text-[12.5px] leading-7 text-white/75 sm:px-6 sm:text-[13px]"><code set:html={profileCode} /></pre>

        <div class="flex items-center gap-2.5 border-t border-white/10 px-5 py-4 font-mono text-[11px] text-white/50 sm:px-6">
          <span class="size-1.5 rounded-full bg-mint" aria-hidden="true"></span>
          .NET 6 · Oracle PL/SQL · Azure
        </div>
      </figure>

      <div class="absolute -bottom-6 right-6 hidden items-center gap-3 rounded-2xl border border-line bg-white px-4 py-3 shadow-card sm:flex">
        <span class="grid size-8 place-items-center rounded-full bg-accent-soft text-accent" aria-hidden="true">
          <Icon name="check" class="size-4" />
        </span>
        <span class="text-xs font-semibold text-ink">{t.heroBadge}</span>
      </div>
    </div>
  </div>
</section>
